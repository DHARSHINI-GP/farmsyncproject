# Copy to .env. Never commit real credentials.
FARMSYNC_HOST=127.0.0.1
FARMSYNC_PORT=8000
FARMSYNC_OFFLINE=true
FARMSYNC_DEMO_MODE=false
# Set a strong secret before allowing network access, including through a proxy.
FARMSYNC_API_KEY=
FARMSYNC_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FARMSYNC_MAX_UPLOAD_SIZE=15728640
AWS_DEFAULT_REGION=ap-south-1
# Fill these only for cloud operation, and set FARMSYNC_OFFLINE=false.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=mistral.ministral-3-3b-instruct
BEDROCK_VISION_MODEL_ID=mistral.ministral-3-8b-instruct
# Optional: use a signed-in CLI SSO profile instead of temporary keys above.
# FARMSYNC_AWS_PROFILE=fai-tce-team26
# Optional cloud retrieval; local retrieval remains the default.
FARMSYNC_EMBEDDINGS_PROVIDER=local
# Set to your organization's trusted CA bundle if TLS inspection is used.
# AWS_CA_BUNDLE=/path/to/trusted-ca-bundle.pem
# Amazon Location is not included in the provided Task 1 service list.
# Enable only after the organizer explicitly grants additional access.
FARMSYNC_AMAZON_LOCATION_ENABLED=false
# Separate organizer-assigned Builder-Location session; preserves the AI session.
LOCATION_AWS_ACCESS_KEY_ID=
LOCATION_AWS_SECRET_ACCESS_KEY=
LOCATION_AWS_SESSION_TOKEN=
# Alternative to the three Location keys:
# FARMSYNC_LOCATION_AWS_PROFILE=fai-tce-team26-location
AMAZON_LOCATION_INDEX=fai-tce-team26-places
AMAZON_LOCATION_ROUTER=fai-tce-team26-routes
AMAZON_LOCATION_GEOFENCE=fai-tce-team26-geofences
# AWS secrets are not edited in the browser. Legacy local administration only:
FARMSYNC_ALLOW_RUNTIME_CREDENTIALS=false
